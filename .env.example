# 複製成 .env.local（不入倉庫）。本機開發直接用 Docker 的 postgres17。
# 真正的密碼寫在 .env.local（已列入 .gitignore），這裡只留範例。
#
# 注意：密碼含 @ 時要百分號編碼成 %40，否則 URI 解析會在第一個 @ 就切開。
#   本機直跑（Windows → 映射埠 5432）：
DATABASE_URL=postgresql://admin:%40<password>@localhost:5432/awsLucaPysn
#   在容器內跑時 host 要用 postgres17（shared-network 的 DNS alias），不能寫 localhost：
# DATABASE_URL=postgresql://admin:%40<password>@postgres17:5432/awsLucaPysn

DB_DRIVER=docker
APP_ENV=development
AWS_REGION=ap-southeast-2

# 連線池（每個 gunicorn worker 各一個池）
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10

# Neon 的 pooler 是 transaction mode pooling：不支援 prepared statements / session 級 SET
DB_PREPARE=false

PORT=8000
GUNICORN_WORKERS=1
LOG_LEVEL=info

# 正式區（ECS）會把 DATABASE_URL 放 Secrets Manager；DB_SSLMODE=require
# DB_DRIVER=neon
# DB_SSLMODE=require
